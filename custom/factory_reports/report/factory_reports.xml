<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Manufacturing Order Card -->
    <record id="action_report_mrp_order_card" model="ir.actions.report">
        <field name="name">Manufacturing Order Card / Traveler</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">factory_reports.report_mrp_order_card_template</field>
        <field name="report_file">factory_reports.report_mrp_order_card_template</field>
        <field name="print_report_name">'MO_Traveler_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 2. BOM / Material Requirement Sheet -->
    <record id="action_report_mrp_bom_sheet" model="ir.actions.report">
