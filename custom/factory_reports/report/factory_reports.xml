        <field name="report_name">factory_reports.report_mrp_bom_sheet_template</field>
        <field name="report_file">factory_reports.report_mrp_bom_sheet_template</field>
        <field name="print_report_name">'BOM_Sheet_' + (object.code or object.product_tmpl_id.name)</field>
        <field name="binding_model_id" ref="mrp.model_mrp_bom"/>
        <field name="binding_type">report</field>
    </record>

