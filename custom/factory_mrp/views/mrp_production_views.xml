<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_factory" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.factory</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="supervisor_id"/>
                <field name="production_shift"/>
                <field name="has_rework_operations" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='miscellaneous']" position="inside">
                <group string="Industrial Audit &amp; Variances">
                    <field name="actual_vs_planned_material_pct" readonly="1"/>
                    <field name="actual_vs_planned_duration_pct" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
