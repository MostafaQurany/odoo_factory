<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Industrial Persona Roles -->
    <record id="group_factory_storekeeper" model="res.groups">
        <field name="name">Store Keeper / Warehouseman</field>
        <field name="category_id" ref="factory_base.module_category_factory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_factory_purchase_officer" model="res.groups">
        <field name="name">Purchase Officer</field>
        <field name="category_id" ref="factory_base.module_category_factory"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="group_factory_purchase_manager" model="res.groups">
        <field name="name">Purchase Manager</field>
        <field name="category_id" ref="factory_base.module_category_factory"/>
        <field name="implied_ids" eval="[(4, ref('group_factory_purchase_officer')), (4, ref('purchase.group_purchase_manager'))]"/>
    </record>

    <record id="group_factory_production_supervisor" model="res.groups">
        <field name="name">Production Supervisor</field>
        <field name="category_id" ref="factory_base.module_category_factory"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
    </record>

    <record id="group_factory_sales_officer" model="res.groups">
        <field name="name">Sales User</field>
        <field name="category_id" ref="factory_base.module_category_factory"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_factory_accountant" model="res.groups">
        <field name="name">Factory Accountant</field>
        <field name="category_id" ref="factory_base.module_category_factory"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_factory_executive_readonly" model="res.groups">
        <field name="name">Executive Read-Only</field>
        <field name="category_id" ref="factory_base.module_category_factory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
