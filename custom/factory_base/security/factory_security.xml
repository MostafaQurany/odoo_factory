<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_factory">
        <field name="name">Factory Platform</field>
        <field name="description">Factory ERP Operational Roles and Access Rights</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_factory_user" model="res.groups">
        <field name="name">Operator</field>
        <field name="category_id" ref="module_category_factory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_factory_quality" model="res.groups">
        <field name="name">Quality Inspector</field>
        <field name="category_id" ref="module_category_factory"/>
        <field name="implied_ids" eval="[(4, ref('group_factory_user'))]"/>
    </record>

    <record id="group_factory_engineer" model="res.groups">
        <field name="name">Process Engineer</field>
        <field name="category_id" ref="module_category_factory"/>
        <field name="implied_ids" eval="[(4, ref('group_factory_user'))]"/>
    </record>

    <record id="group_factory_manager" model="res.groups">
        <field name="name">Factory Manager</field>
        <field name="category_id" ref="module_category_factory"/>
        <field name="implied_ids" eval="[(4, ref('group_factory_engineer')), (4, ref('group_factory_quality'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
