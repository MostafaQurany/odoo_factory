<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_factory" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.factory</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_manufacturing_orders" type="object" class="oe_stat_button" icon="fa-wrench" invisible="production_order_count == 0">
                    <field name="production_order_count" widget="statinfo" string="Manufacturing"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="factory_demand_type"/>
                <field name="customer_delivery_tolerance_days"/>
            </xpath>
        </field>
    </record>
</odoo>
