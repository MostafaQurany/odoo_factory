{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HealthChecksContract",
  "type": "object",
  "required": ["system_checks", "data_checks"],
  "properties": {
    "system_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "command", "expected"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "command": {"type": "string"},
          "expected": {"type": "string"}
        }
      }
    },
    "data_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "target_model", "criteria"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "target_model": {"type": "string"},
          "criteria": {"type": "string"}
        }
      }
    }
  }
}
