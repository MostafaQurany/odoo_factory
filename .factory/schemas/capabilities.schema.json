{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CapabilitiesContract",
  "type": "object",
  "required": ["capabilities"],
  "properties": {
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "classification", "requires", "modules", "conflicts", "profiles", "tests"],
        "properties": {
          "status": {"type": "string", "enum": ["approved", "experimental", "deprecated"]},
          "classification": {
            "type": "string",
            "enum": ["CORE", "OPERATIONS", "ADVANCED", "INFRASTRUCTURE", "INTEGRATION", "UI", "DEV", "TEST", "HARDWARE", "LEGACY", "UNCLASSIFIED"]
          },
          "description": {"type": "string"},
          "requires": {
            "type": "array",
            "items": {"type": "string"}
          },
          "modules": {
            "type": "object",
            "required": ["required"],
            "properties": {
              "required": {
                "type": "array",
                "items": {"type": "string"}
              },
              "optional": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          },
          "conflicts": {
            "type": "array",
            "items": {"type": "string"}
          },
          "profiles": {
            "type": "array",
            "items": {"type": "string"}
          },
          "tests": {
            "type": "array",
            "items": {"type": "string"}
          },
          "documentation": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
