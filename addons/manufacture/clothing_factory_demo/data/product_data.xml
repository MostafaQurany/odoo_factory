<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Raw Materials -->
    <record id="product_raw_cotton_fabric" model="product.product">
        <field name="name">100% Organic Cotton Fabric Roll</field>
        <field name="default_code">RAW-COT-01</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="uom_id" ref="uom.product_uom_meter" />
        <field name="uom_po_id" ref="uom.product_uom_meter" />
        <field name="standard_price">4.50</field>
        <field name="list_price">6.50</field>
